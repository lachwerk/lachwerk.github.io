 "invite": {
  "subject": "Du bist zu Lachwerk eingeladen 😂",
  "html": "<!doctype html>\n<html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light only\"><title>Du bist eingeladen!</title></head>\n<body style=\"margin:0;padding:0;background:#ffc928\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Jemand möchte mit dir lachen.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffc928\">\n  <tr><td align=\"center\" style=\"padding:28px 14px 36px\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px\">\n      <tr><td style=\"padding:0 6px 20px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n          <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;color:#15172a;letter-spacing:-.5px\">Lach</td>\n          <td style=\"padding-left:3px\"><span style=\"display:inline-block;background:#15172a;color:#ffc928;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;letter-spacing:-.5px;padding:0 8px 2px;border-radius:7px\">werk</span></td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:0 6px 22px\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffffff;border-radius:22px;border-bottom:6px solid #15172a\">\n          <tr><td style=\"padding:30px 28px 28px\">\n            <div style=\"font-size:40px;line-height:1\">💌</div>\n            <h1 style=\"margin:14px 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;line-height:1.25;font-weight:800;color:#15172a\">Du bist eingeladen!</h1>\n            <p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\">Du wurdest zu <b>Lachwerk</b> eingeladen, der Seite, auf der jeden Abend der beste Witz des Tages gekrönt wird.</p><p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\">Mit einem Klick nimmst du die Einladung an und legst dein Konto an.</p>\n            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:26px 0 8px\">\n        <tr><td style=\"border-radius:999px;background:#15172a\">\n          <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:15px 30px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;font-weight:800;color:#ffc928;text-decoration:none;border-radius:999px\">Einladung annehmen</a>\n        </td></tr></table>\n        <p style=\"margin:14px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#5b5f78\">Button funktioniert nicht? Kopiere diesen Link in deinen Browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#5b5f78;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n            <p style=\"margin:18px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#5b5f78\">Keine Lust? Dann ignoriere diese E-Mail einfach.</p>\n          </td></tr>\n        </table>\n      </td></tr>\n      <tr><td style=\"padding:0 6px 22px\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#15172a;border-radius:18px\">\n        <tr><td style=\"padding:18px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n          <div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#ffc928\">😂 Kleiner Witz zwischendurch</div>\n          <div style=\"margin-top:8px;font-size:15px;line-height:1.5;color:#ffffff\">Warum können Geister so schlecht lügen? Weil man durch sie hindurchsieht.</div>\n        </td></tr></table>\n    </td></tr>\n      <tr><td style=\"padding:0 10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#4a3c06;text-align:center\">\n        Du bekommst diese E-Mail, weil dich jemand zu Lachwerk eingeladen hat.<br>\n        <a href=\"https://lach-werk.de/\" style=\"color:#4a3c06;font-weight:700\">lach-werk.de</a> · Die besten Witze des Tages<br>\n        Lachwerk ist ein privates Hobbyprojekt · <a href=\"https://lach-werk.de/impressum.html\" style=\"color:#4a3c06\">Impressum</a> · <a href=\"https://lach-werk.de/datenschutz.html\" style=\"color:#4a3c06\">Datenschutz</a>\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>"
 },
 "email_change": {
  "subject": "Bitte bestätige deine neue E-Mail-Adresse 📬",
  "html": "<!doctype html>\n<html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light only\"><title>Neue Adresse, gleicher Humor</title></head>\n<body style=\"margin:0;padding:0;background:#ffc928\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Ein Klick, dann ist die neue Adresse aktiv.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffc928\">\n  <tr><td align=\"center\" style=\"padding:28px 14px 36px\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px\">\n      <tr><td style=\"padding:0 6px 20px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n          <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;color:#15172a;letter-spacing:-.5px\">Lach</td>\n          <td style=\"padding-left:3px\"><span style=\"display:inline-block;background:#15172a;color:#ffc928;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;letter-spacing:-.5px;padding:0 8px 2px;border-radius:7px\">werk</span></td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:0 6px 22px\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffffff;border-radius:22px;border-bottom:6px solid #15172a\">\n          <tr><td style=\"padding:30px 28px 28px\">\n            <div style=\"font-size:40px;line-height:1\">📬</div>\n            <h1 style=\"margin:14px 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;line-height:1.25;font-weight:800;color:#15172a\">Neue Adresse, gleicher Humor</h1>\n            <p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\">Du möchtest die E-Mail-Adresse deines Lachwerk-Kontos von <b>{{ .Email }}</b> auf <b>{{ .NewEmail }}</b> ändern.</p><p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\">Bitte bestätige das mit einem Klick.</p>\n            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:26px 0 8px\">\n        <tr><td style=\"border-radius:999px;background:#15172a\">\n          <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:15px 30px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;font-weight:800;color:#ffc928;text-decoration:none;border-radius:999px\">Neue Adresse bestätigen</a>\n        </td></tr></table>\n        <p style=\"margin:14px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#5b5f78\">Button funktioniert nicht? Kopiere diesen Link in deinen Browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#5b5f78;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n            <p style=\"margin:18px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#5b5f78\">Du hast das nicht veranlasst? Dann ignoriere diese E-Mail. Deine bisherige Adresse bleibt aktiv.</p>\n          </td></tr>\n        </table>\n      </td></tr>\n      <tr><td style=\"padding:0 6px 22px\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#15172a;border-radius:18px\">\n        <tr><td style=\"padding:18px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n          <div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#ffc928\">😂 Kleiner Witz zwischendurch</div>\n          <div style=\"margin-top:8px;font-size:15px;line-height:1.5;color:#ffffff\">Ich habe meiner Frau gesagt, sie soll mich nicht unterbrechen. Seitdem schreibt sie mir E-Mails.</div>\n        </td></tr></table>\n    </td></tr>\n      <tr><td style=\"padding:0 10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#4a3c06;text-align:center\">\n        Du bekommst diese E-Mail, weil eine Änderung der Adresse angefordert wurde.<br>\n        <a href=\"https://lach-werk.de/\" style=\"color:#4a3c06;font-weight:700\">lach-werk.de</a> · Die besten Witze des Tages<br>\n        Lachwerk ist ein privates Hobbyprojekt · <a href=\"https://lach-werk.de/impressum.html\" style=\"color:#4a3c06\">Impressum</a> · <a href=\"https://lach-werk.de/datenschutz.html\" style=\"color:#4a3c06\">Datenschutz</a>\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>"
 },
 "reauthentication": {
  "subject": "Dein Bestätigungscode für Lachwerk 🔐",
  "html": "<!doctype html>\n<html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light only\"><title>Kurz bestätigen, dass du es bist</title></head>\n<body style=\"margin:0;padding:0;background:#ffc928\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Dein Code für die Bestätigung.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffc928\">\n  <tr><td align=\"center\" style=\"padding:28px 14px 36px\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px\">\n      <tr><td style=\"padding:0 6px 20px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n          <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;color:#15172a;letter-spacing:-.5px\">Lach</td>\n          <td style=\"padding-left:3px\"><span style=\"display:inline-block;background:#15172a;color:#ffc928;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;letter-spacing:-.5px;padding:0 8px 2px;border-radius:7px\">werk</span></td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:0 6px 22px\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffffff;border-radius:22px;border-bottom:6px solid #15172a\">\n          <tr><td style=\"padding:30px 28px 28px\">\n            <div style=\"font-size:40px;line-height:1\">🔐</div>\n            <h1 style=\"margin:14px 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;line-height:1.25;font-weight:800;color:#15172a\">Kurz bestätigen, dass du es bist</h1>\n            <p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\">Für eine wichtige Änderung an deinem Konto brauchen wir eine kurze Bestätigung. Gib diesen Code in der App ein:</p><p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\"><span style=\"display:inline-block;background:#ffc928;border-radius:12px;padding:10px 18px;font-size:28px;font-weight:800;letter-spacing:6px;color:#15172a\">{{ .Token }}</span></p>\n            \n            <p style=\"margin:18px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#5b5f78\">Du warst das nicht? Dann kannst du diese E-Mail einfach ignorieren, es passiert nichts.</p>\n          </td></tr>\n        </table>\n      </td></tr>\n      <tr><td style=\"padding:0 6px 22px\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#15172a;border-radius:18px\">\n        <tr><td style=\"padding:18px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n          <div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#ffc928\">😂 Kleiner Witz zwischendurch</div>\n          <div style=\"margin-top:8px;font-size:15px;line-height:1.5;color:#ffffff\">Warum nehmen Geheimagenten immer Kaffee mit? Weil sie bohnenstark sein müssen.</div>\n        </td></tr></table>\n    </td></tr>\n      <tr><td style=\"padding:0 10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#4a3c06;text-align:center\">\n        Du bekommst diese E-Mail, weil eine Bestätigung für dein Konto angefordert wurde.<br>\n        <a href=\"https://lach-werk.de/\" style=\"color:#4a3c06;font-weight:700\">lach-werk.de</a> · Die besten Witze des Tages<br>\n        Lachwerk ist ein privates Hobbyprojekt · <a href=\"https://lach-werk.de/impressum.html\" style=\"color:#4a3c06\">Impressum</a> · <a href=\"https://lach-werk.de/datenschutz.html\" style=\"color:#4a3c06\">Datenschutz</a>\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>"
 },
 "password_changed_notification": {
  "subject": "Dein Lachwerk-Passwort wurde geändert ✅",
  "html": "<!doctype html>\n<html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light only\"><title>Passwort erfolgreich geändert</title></head>\n<body style=\"margin:0;padding:0;background:#ffc928\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Nur zur Info: Dein Passwort ist neu.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffc928\">\n  <tr><td align=\"center\" style=\"padding:28px 14px 36px\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px\">\n      <tr><td style=\"padding:0 6px 20px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n          <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;color:#15172a;letter-spacing:-.5px\">Lach</td>\n          <td style=\"padding-left:3px\"><span style=\"display:inline-block;background:#15172a;color:#ffc928;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;letter-spacing:-.5px;padding:0 8px 2px;border-radius:7px\">werk</span></td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:0 6px 22px\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffffff;border-radius:22px;border-bottom:6px solid #15172a\">\n          <tr><td style=\"padding:30px 28px 28px\">\n            <div style=\"font-size:40px;line-height:1\">✅</div>\n            <h1 style=\"margin:14px 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;line-height:1.25;font-weight:800;color:#15172a\">Passwort erfolgreich geändert</h1>\n            <p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\">Das Passwort deines Lachwerk-Kontos (<b>{{ .Email }}</b>) wurde gerade geändert.</p><p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\">Wenn du das warst: alles gut, nichts weiter zu tun.</p>\n            \n            <p style=\"margin:18px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#5b5f78\">Du warst das nicht? Dann setze sofort über „Passwort vergessen“ ein neues Passwort und schreib uns an <a href=\"mailto:kontakt@lach-werk.de\" style=\"color:#5b5f78\">kontakt@lach-werk.de</a>.</p>\n          </td></tr>\n        </table>\n      </td></tr>\n      \n      <tr><td style=\"padding:0 10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#4a3c06;text-align:center\">\n        Du bekommst diese E-Mail zur Sicherheit deines Kontos.<br>\n        <a href=\"https://lach-werk.de/\" style=\"color:#4a3c06;font-weight:700\">lach-werk.de</a> · Die besten Witze des Tages<br>\n        Lachwerk ist ein privates Hobbyprojekt · <a href=\"https://lach-werk.de/impressum.html\" style=\"color:#4a3c06\">Impressum</a> · <a href=\"https://lach-werk.de/datenschutz.html\" style=\"color:#4a3c06\">Datenschutz</a>\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>"
 },
 "email_changed_notification": {
  "subject": "Deine E-Mail-Adresse bei Lachwerk wurde geändert ✅",
  "html": "<!doctype html>\n<html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light only\"><title>E-Mail-Adresse geändert</title></head>\n<body style=\"margin:0;padding:0;background:#ffc928\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Nur zur Info: Deine Adresse ist neu.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffc928\">\n  <tr><td align=\"center\" style=\"padding:28px 14px 36px\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px\">\n      <tr><td style=\"padding:0 6px 20px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n          <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;color:#15172a;letter-spacing:-.5px\">Lach</td>\n          <td style=\"padding-left:3px\"><span style=\"display:inline-block;background:#15172a;color:#ffc928;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:30px;font-weight:800;letter-spacing:-.5px;padding:0 8px 2px;border-radius:7px\">werk</span></td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:0 6px 22px\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffffff;border-radius:22px;border-bottom:6px solid #15172a\">\n          <tr><td style=\"padding:30px 28px 28px\">\n            <div style=\"font-size:40px;line-height:1\">✅</div>\n            <h1 style=\"margin:14px 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;line-height:1.25;font-weight:800;color:#15172a\">E-Mail-Adresse geändert</h1>\n            <p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\">Die E-Mail-Adresse deines Lachwerk-Kontos wurde geändert.</p><p style=\"margin:0 0 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#15172a\">Wenn du das warst: alles gut, nichts weiter zu tun.</p>\n            \n            <p style=\"margin:18px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#5b5f78\">Du warst das nicht? Dann schreib uns bitte an <a href=\"mailto:kontakt@lach-werk.de\" style=\"color:#5b5f78\">kontakt@lach-werk.de</a>.</p>\n          </td></tr>\n        </table>\n      </td></tr>\n      \n      <tr><td style=\"padding:0 10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#4a3c06;text-align:center\">\n        Du bekommst diese E-Mail zur Sicherheit deines Kontos.<br>\n        <a href=\"https://lach-werk.de/\" style=\"color:#4a3c06;font-weight:700\">lach-werk.de</a> · Die besten Witze des Tages<br>\n        Lachwerk ist ein privates Hobbyprojekt · <a href=\"https://lach-werk.de/impressum.html\" style=\"color:#4a3c06\">Impressum</a> · <a href=\"https://lach-werk.de/datenschutz.html\" style=\"color:#4a3c06\">Datenschutz</a>\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>"
 }
